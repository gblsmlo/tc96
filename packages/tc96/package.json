{
  "name": "tc96",
  "version": "0.1.0",
  "description": "Domain-neutral React patterns and COSS adapters.",
  "author": "Gabriel Melo",
  "repository": { "type": "git", "url": "git+https://github.com/gblsmlo/tc96.git" },
  "homepage": "https://github.com/gblsmlo/tc96#readme",
  "bugs": { "url": "https://github.com/gblsmlo/tc96/issues" },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "registry", "README.md", "LICENSE"],
  "exports": {
    "./view": { "types": "./dist/view/index.d.ts", "import": "./dist/view/index.js" },
    "./view/core": { "types": "./dist/view/core.d.ts", "import": "./dist/view/core.js" },
    "./properties": { "types": "./dist/properties/index.d.ts", "import": "./dist/properties/index.js" },
    "./properties/core": { "types": "./dist/properties/core.d.ts", "import": "./dist/properties/core.js" },
    "./datagrid": { "types": "./dist/datagrid/index.d.ts", "import": "./dist/datagrid/index.js" },
    "./datagrid/core": { "types": "./dist/datagrid/core.d.ts", "import": "./dist/datagrid/core.js" },
    "./detail-sheet": { "types": "./dist/detail-sheet/index.d.ts", "import": "./dist/detail-sheet/index.js" },
    "./detail-sheet/core": { "types": "./dist/detail-sheet/core.d.ts", "import": "./dist/detail-sheet/core.js" },
    "./editable": { "types": "./dist/editable/index.d.ts", "import": "./dist/editable/index.js" },
    "./editable/core": { "types": "./dist/editable/core.d.ts", "import": "./dist/editable/core.js" },
    "./filter-builder": { "types": "./dist/filter-builder/index.d.ts", "import": "./dist/filter-builder/index.js" },
    "./filter-builder/core": { "types": "./dist/filter-builder/core.d.ts", "import": "./dist/filter-builder/core.js" },
    "./registry/view": "./registry/generated/view.json",
    "./registry/properties": "./registry/generated/properties.json",
    "./registry/datagrid": "./registry/generated/datagrid.json",
    "./registry/detail-sheet": "./registry/generated/detail-sheet.json",
    "./registry/editable": "./registry/generated/editable.json",
    "./registry/filter-builder": "./registry/generated/filter-builder.json"
  },
  "scripts": {
    "build": "bun scripts/build-registry.ts && bun scripts/build-package.ts && tsc -p tsconfig.view.json && tsc -p tsconfig.properties.json && tsc -p tsconfig.datagrid.json && tsc -p tsconfig.detail-sheet.json && tsc -p tsconfig.editable.json && tsc -p tsconfig.filter-builder.json && bun scripts/rewrite-declarations.ts",
    "lint:ci": "biome ci tests scripts",
    "pack:check": "npm pack --dry-run --json --cache /private/tmp/tc96-npm-cache",
    "test": "bun scripts/build-registry.ts && bun test tests src/view/kanban/lib/drag-and-drop.test.ts",
    "typecheck": "tsc -p tsconfig.view.json --noEmit && tsc -p tsconfig.properties.json --noEmit && tsc -p tsconfig.datagrid.json --noEmit && tsc -p tsconfig.detail-sheet.json --noEmit && tsc -p tsconfig.editable.json --noEmit && tsc -p tsconfig.filter-builder.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "react-day-picker": "10.0.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.6.0 <2",
    "react": ">=19.1.1 <20",
    "react-dom": ">=19.1.1 <20",
    "tailwindcss": ">=4.2.2 <5"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@biomejs/biome": "2.3.4",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "6.0.3"
  }
}
